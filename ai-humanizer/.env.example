# SERVER ONLY. Copy this file to .env.local and enter your own key securely.
# Never use a VITE_ prefix for a credential, or commit .env.local.
# Free-only by default: no automatic fallback to paid model routes.
AI_PROVIDER_MODE=free
OPENROUTER_API_KEY_1=
OPENROUTER_FREE_MODEL=openrouter/free
# Optional rotation keys:
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=

# Explicit opt-in to potentially paid providers/models:
# AI_PROVIDER_MODE=configured
# GOOGLE_API_KEY=
# GOOGLE_MODEL_FAST=gemini-2.5-flash
# GOOGLE_MODEL_QUALITY=gemini-2.5-pro

# In configured mode, alternatives include:
# OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
# OPENROUTER_MODEL_QUALITY=google/gemini-2.5-pro
# SAMBANOVA_API_KEY_1=
# CLOUDFLARE_API_KEY_1=
# CLOUDFLARE_ACCOUNT_ID=

# Required for production billable requests (not required for local development).
# Use a dedicated Upstash Redis database. Its REST token needs EVAL permissions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_STAGE_LIMIT=1000
