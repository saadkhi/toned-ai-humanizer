# SERVER ONLY. Copy this file to .env.local and enter your own key securely.
# Never use a VITE_ prefix for a credential, or commit .env.local.
# Free-only by default: no automatic fallback to paid model routes.
AI_PROVIDER_MODE=free
OPENROUTER_API_KEY_1=
OPENROUTER_FREE_MODEL=openrouter/free
# Optional rotation keys:
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=

# Explicit opt-in to potentially paid providers/models:
# AI_PROVIDER_MODE=configured
# GOOGLE_API_KEY=
# GOOGLE_MODEL_FAST=gemini-2.5-flash
# GOOGLE_MODEL_QUALITY=gemini-2.5-pro

# In configured mode, alternatives include:
# OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
# OPENROUTER_MODEL_QUALITY=google/gemini-2.5-pro
# SAMBANOVA_API_KEY_1=
# CLOUDFLARE_API_KEY_1=
# CLOUDFLARE_ACCOUNT_ID=

# Production needs ONE shared request-limit store (local development can omit it).
# Choose auto, neon, or upstash. Explicit selection never falls back to another store.
# Auto chooses Upstash if either Redis variable is set, otherwise Neon if a URL is set.
RATE_LIMIT_STORE=auto

# Neon Postgres option: run db/neon-rate-limits.sql once in this database first.
# In Vercel use RATE_LIMIT_STORE=neon and DATABASE_URL from Neon's Connect dialog.
# The server accepts a *.neon.tech PostgreSQL URL with sslmode=require or verify-full.
# NEON_DATABASE_URL is also supported; use one URL variable consistently.
DATABASE_URL=
# NEON_DATABASE_URL=

# Upstash Redis option: use RATE_LIMIT_STORE=upstash and both values below.
# Its REST token needs EVAL permissions. Upstash is not needed with Neon.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_STAGE_LIMIT=1000
